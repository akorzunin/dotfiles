#!/usr/bin/env nu

def paths [] {
  let state = (($env.XDG_STATE_HOME? | default ($env.HOME | path join .local state)) | path join rclone)
  {
    dir: ($env.HOME | path join Dropbox)
    state: ($state | path join bisync)
    backups: ($state | path join backups)
  }
}

def dropbox-remote [] {
  let result = (^rclone listremotes --type dropbox | complete)
  if $result.exit_code != 0 {
    error make {msg: ($result.stderr | str trim)}
  }

  let remotes = ($result.stdout | lines)
  if ($remotes | is-empty) {
    error make {msg: "No Dropbox remote configured. Run: dropbox-sync --setup"}
  }
  if "dropbox:" in $remotes {
    return "dropbox:"
  }
  if ($remotes | length) == 1 {
    return ($remotes | first)
  }
  error make {msg: $"Multiple Dropbox remotes found: ($remotes | str join ', ')"}
}

def is-mounted [dir: path] {
  (^mountpoint -q $dir | complete).exit_code == 0
}

def setup [] {
  print 'rclone config answers (the two dropbox values are BOTH required):'
  print '  n) New remote  -> n'
  print '  name> dropbox          <- REMOTE NAME'
  print '  Storage> dropbox       <- BACKEND TYPE (or its listed number)'
  print 'Leave client ID/secret blank unless you have your own app. Skip advanced config.'
  print 'SSH without a browser on the VM: at "Use web browser to automatically authenticate?" answer n.'
  print 'On your local computer (with a browser and rclone), run: rclone authorize dropbox'
  print 'Paste the resulting token into the VM config_token prompt (not into chat).'
  print 'Alternatively connect from your computer with: ssh -L 53682:localhost:53682 archlinux'
  print 'Then answer y to browser auth and open the printed 127.0.0.1:53682 URL on your computer.'
  print 'Confirm the remote and quit. ~/Dropbox is the separate local folder, not the remote name.'
  print 'Setup does not sync or enable autosync. Next: --sync --init --dry-run, --sync --init, then --schedule 30s.'
  ^rclone config
  if $env.LAST_EXIT_CODE != 0 {
    error make {msg: "rclone configuration failed"}
  }
  print $"Configured (dropbox-remote)"
}

def systemd-state [unit: string] {
  let result = (^systemctl --user show $unit --property=LoadState,ActiveState,UnitFileState,Result,ExecMainStatus,ExecMainExitTimestamp | complete)
  if $result.exit_code != 0 {
    error make {msg: ($result.stderr | str trim)}
  }
  $result.stdout | lines | parse '{key}={value}' | transpose --header-row --as-record
}

def check-sync [] {
  let p = (paths)
  let initialized = (($p.state | path join initialized) | path exists)
  print $"Initialized: ($initialized)"
  let timer = (systemd-state dropbox-sync.timer)
  if $timer.LoadState == "not-found" {
    print "Autosync: not scheduled. Enable with: dropbox-sync --schedule 30s"
    return
  }
  let enabled = ($timer.UnitFileState == "enabled")
  let active = ($timer.ActiveState == "active")
  print $"Autosync: (if $active { 'ON' } else { 'OFF' })"
  print $"Timer: ($timer.ActiveState), ($timer.UnitFileState)"
  if $active and not $enabled { print "Warning: timer is not enabled for future user-manager startups." }
  if not $initialized { print "Warning: initialize with --sync --init before syncing." }

  let service = (systemd-state dropbox-sync.service)
  print $"Service: ($service.ActiveState)"
  if $service.ActiveState in [activating active deactivating] {
    print "Sync: running"
  } else if ($service.ExecMainExitTimestamp | is-empty) {
    print "Last sync: not run yet"
  } else {
    print $"Last sync: ($service.ExecMainExitTimestamp)"
    print $"Last result: ($service.Result) \(exit ($service.ExecMainStatus)\)"
  }
  ^systemctl --user list-timers --all dropbox-sync.timer --no-pager
  if $env.LAST_EXIT_CODE != 0 { error make {msg: "Could not read timer schedule"} }
  print "Logs: journalctl --user -u dropbox-sync.service -n 50 --no-pager"
}

# One lock per local folder; transfers are serialized, not concurrent.
def transfer [mode: string, dry_run: bool, initialize: bool] {
  let p = (paths)
  if (is-mounted $p.dir) {
    error make {msg: "Dropbox is still mounted. Safely unmount it before running local transfers."}
  }
  let remote = (dropbox-remote)
  let state = $p.state
  let ready = ($state | path join initialized)
  if $mode == "sync" and not $initialize and not ($ready | path exists) {
    error make {msg: "Initialize first: --sync --init --dry-run, then --sync --init. Initialization prefers Dropbox for matching paths; back up both sides first."}
  }
  if $mode != "sync" and ($ready | path exists) {
    error make {msg: "Bisync is initialized; use --sync instead. One-way copies would invalidate its change tracking."}
  }
  if $mode == "push" and not ($p.dir | path exists) {
    error make {msg: "Local Dropbox folder does not exist; nothing to upload."}
  }
  mkdir $p.dir $state
  mut args = if $mode == "pull" {
    [copy $remote $p.dir --update]
  } else if $mode == "push" {
    [copy $p.dir $remote --update]
  } else {
    # Timestamp ties still need manual resolution; keep the loser for recovery.
    [bisync $p.dir $remote --workdir $state --resilient --recover --conflict-resolve newer --conflict-loser num]
  }
  if $initialize { $args = ($args | append [--resync --resync-mode path2]) }
  if $dry_run { $args = ($args | append '--dry-run') }
  # Leftovers from the Dropbox desktop client are local-only (and .dropbox is
  # rejected by the API). Apply the same filters to every transfer, including
  # bisync resync, so these files never enter its change tracking.
  $args = ($args | append [--exclude /.dropbox --exclude /.dropbox.attr --exclude /.dropbox.cache/** --exclude /.Trash-*/**])
  # Keep replaced copy destinations outside the synced tree, on the same backend.
  if $mode != "sync" {
    let stamp = (date now | format date "%Y%m%dT%H%M%S%f")
    let backup = if $mode == "pull" {
      $p.backups | path join $stamp
    } else {
      $"($remote).dropbox-sync-backups/($stamp)"
    }
    $args = ($args | append [--backup-dir $backup --exclude /.dropbox-sync-backups/**])
  } else {
    $args = ($args | append [--exclude /.dropbox-sync-backups/**])
  }
  ^flock --nonblock ($state | path join transfer.lock) rclone ...$args --verbose --contimeout 15s --timeout 1m
  if $env.LAST_EXIT_CODE != 0 {
    error make {msg: "Transfer failed or another transfer is running. Inspect rclone's output. If bisync aborted, back up both sides and review --sync --init --dry-run before retrying --sync --init; do not automatically reinitialize."}
  }
  if $initialize and not $dry_run { "" | save --force $ready }
}

def schedule [interval: string] {
  let p = (paths)
  let ready = ($p.state | path join initialized)
  if not ($ready | path exists) or (is-mounted $p.dir) {
    error make {msg: "Unmount Dropbox and complete --sync --init before enabling the schedule."}
  }
  if $interval !~ '^[1-9][0-9]*(s|min|h)$' {
    error make {msg: "Interval must be a positive integer followed by s, min, or h (for example 30s or 5min)."}
  }
  let units = (($env.XDG_CONFIG_HOME? | default ($env.HOME | path join .config)) | path join systemd user)
  mkdir $units
  let script = ($env.CURRENT_FILE | path expand)
  let nu_bin = (which nu | first | get path)
  # systemd treats percent signs as specifiers, even inside quotes.
  let command = ([$nu_bin $script] | each {|s| '"' + ($s | str replace --all '\' '\\' | str replace --all '"' '\"' | str replace --all '%' '%%' | str replace --all '$' '$$') + '"' } | str join ' ')
  $"[Unit]\nDescription=Two-way Dropbox sync\n\n[Service]\nType=oneshot\nExecStart=($command) --sync\n" | save --force ($units | path join dropbox-sync.service)
  $"[Unit]\nDescription=Periodically sync Dropbox\n\n[Timer]\nOnStartupSec=30s\nOnUnitInactiveSec=($interval)\nAccuracySec=1s\n\n[Install]\nWantedBy=timers.target\n" | save --force ($units | path join dropbox-sync.timer)
  ^systemctl --user daemon-reload
  if $env.LAST_EXIT_CODE != 0 { error make {msg: "systemd user daemon-reload failed"} }
  ^systemctl --user enable --now dropbox-sync.timer
  if $env.LAST_EXIT_CODE != 0 { error make {msg: "Could not enable timer"} }
  ^systemctl --user restart dropbox-sync.timer
  if $env.LAST_EXIT_CODE != 0 { error make {msg: "Could not restart timer"} }
  print $"Sync scheduled every ($interval) after completion while your user manager runs. Logs: journalctl --user -u dropbox-sync.service"
}

def main [
  --pull        # Download without deleting; skip newer local files, back up replacements
  --push        # Upload without deleting; skip newer remote files, back up replacements
  --sync        # Run two-way sync (including deletions); newer wins, keep conflict copies
  --init        # Initialize/rebuild bisync tracking; Dropbox wins matching paths
  --dry-run     # Preview a transfer without changing files
  --schedule: string # Enable two-way sync timer, e.g. --schedule 30s
  --unschedule  # Disable timer and stop its running transfer
  --setup (-s)  # Open rclone's interactive configuration (does not sync)
  --check (-c)  # Show autosync timer, next run, and last scheduled sync result
] {
  if ([$setup $check $pull $push $sync ($schedule != null) $unschedule] | where {$in} | length) > 1 {
    error make {msg: "Choose only one option"}
  }

  if $init and not $sync { error make {msg: "--init requires --sync"} }
  if $dry_run and not ($pull or $push or $sync) { error make {msg: "--dry-run requires --pull, --push, or --sync"} }
  if ($setup or $pull or $push or $sync) and (which rclone | is-empty) {
    error make {msg: "rclone is not installed"}
  }
  if not ($setup or $pull or $push or $sync) and (which systemctl | is-empty) {
    error make {msg: "systemctl is required for autosync scheduling and status"}
  }
  if $pull or $push or $sync {
    if (which flock | is-empty) { error make {msg: "flock is required for local transfers"} }
    transfer (if $pull { "pull" } else if $push { "push" } else { "sync" }) $dry_run $init
  } else if $schedule != null {
    schedule $schedule
  } else if $unschedule {
    ^systemctl --user disable --now dropbox-sync.timer
    if $env.LAST_EXIT_CODE != 0 { error make {msg: "Could not disable timer"} }
    ^systemctl --user stop dropbox-sync.service
    if $env.LAST_EXIT_CODE != 0 { error make {msg: "Could not stop transfer"} }
  } else if $setup { setup } else { check-sync }
}
