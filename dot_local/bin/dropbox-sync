#!/usr/bin/env nu

let POLL_INTERVAL = "1h"

# rclone's --daemon and remote control cannot share a socket, so the mount is
# detached with nohup instead.
def paths [] {
  let runtime = ($env.XDG_RUNTIME_DIR? | default (($env.TMPDIR? | default /tmp) | path join $"rclone-(id -u | str trim)"))
  {
    dir: ($env.HOME | path join Dropbox)
    runtime: $runtime
    socket: ($runtime | path join dropbox.sock)
    log: (($env.XDG_STATE_HOME? | default ($env.HOME | path join .local state)) | path join rclone dropbox.log)
  }
}

def dropbox-remote [] {
  let result = (^rclone listremotes --type dropbox | complete)
  if $result.exit_code != 0 {
    error make {msg: ($result.stderr | str trim)}
  }

  let remotes = ($result.stdout | lines)
  if ($remotes | is-empty) {
    error make {msg: "No Dropbox remote configured. Run: dropbox-sync --setup"}
  }
  if "dropbox:" in $remotes {
    return "dropbox:"
  }
  if ($remotes | length) == 1 {
    return ($remotes | first)
  }
  error make {msg: $"Multiple Dropbox remotes found: ($remotes | str join ', ')"}
}

def is-mounted [dir: path] {
  (^mountpoint -q $dir | complete).exit_code == 0
}

def require-mount [] {
  let p = (paths)
  if not (is-mounted $p.dir) {
    error make {msg: "Dropbox is not mounted. Run: dropbox-sync"}
  }
  if not ($p.socket | path exists) {
    error make {msg: "Dropbox was mounted outside this script; remount it with dropbox-sync."}
  }
  $p
}

def rc [socket: path, command: string, ...args: string] {
  let result = (^rclone rc --unix-socket $socket $command ...$args | complete)
  if $result.exit_code != 0 {
    error make {msg: ($result.stderr | str trim)}
  }
  $result.stdout | from json
}

def setup [] {
  print 'Create a Dropbox remote; any name is fine.'
  ^rclone config
  if $env.LAST_EXIT_CODE != 0 {
    error make {msg: "rclone configuration failed"}
  }
  print $"Configured (dropbox-remote)"
}

def mount-dropbox [] {
  let p = (paths)
  let remote = (dropbox-remote)
  if (is-mounted $p.dir) {
    print $"Dropbox is already mounted at ($p.dir)"
    return
  }

  if (($p.log | path dirname | path join bisync initialized) | path exists) {
    error make {msg: "Local two-way sync is initialized; use --sync instead of mounting."}
  }
  mkdir $p.dir $p.runtime ($p.log | path dirname)
  if not (ls -a $p.dir | is-empty) {
    error make {msg: "Dropbox contains local files; refusing to hide them with a mount. Use --pull, --push, or --sync."}
  }
  chmod 700 $p.runtime
  rm -f $p.socket
  let pid = (
    ^sh -c 'log=$1; shift; nohup "$@" >"$log" 2>&1 </dev/null & echo $!'
      sh $p.log rclone mount $remote $p.dir
      --vfs-cache-mode writes
      --poll-interval $POLL_INTERVAL
      --rc
      --rc-addr $"unix://($p.socket)"
      --rc-no-auth
    | into int
  )

  for _ in 1..100 {
    if (is-mounted $p.dir) and ($p.socket | path exists) {
      print $"Dropbox mounted at ($p.dir) using ($remote)"
      return
    }
    if (^kill -0 $pid | complete).exit_code != 0 {
      open --raw $p.log | lines | last 20 | str join (char newline) | print --stderr
      error make {msg: "Dropbox mount failed"}
    }
    sleep 100ms
  }

  do --ignore-errors { ^kill $pid }
  error make {msg: $"Dropbox mount timed out. See ($p.log)"}
}

def unmount-dropbox [] {
  let p = (paths)
  if not (is-mounted $p.dir) {
    print $"Dropbox is already unmounted: ($p.dir)"
    return
  }
  if (which fusermount3 | is-empty) {
    error make {msg: "fusermount3 is required to unmount Dropbox"}
  }
  require-mount | ignore
  let vfs = (rc $p.socket vfs/stats)
  # Fail closed if upload status cannot be read. Close writers before unmounting;
  # the status check and unmount cannot be atomic with application writes.
  let cache = ($vfs | get diskCache)
  if $cache.uploadsQueued != 0 or $cache.uploadsInProgress != 0 or $cache.erroredFiles != 0 or $cache.outOfSpace {
    error make {msg: "Refusing to unmount: uploads are pending or the cache has errors. Run --check and resolve them first."}
  }
  ^fusermount3 -u $p.dir
  if $env.LAST_EXIT_CODE != 0 {
    error make {msg: "Unmount failed. Close applications and terminals accessing ~/Dropbox, then retry --unmount."}
  }
  print $"Dropbox unmounted: ($p.dir)"
}

def tray [] {
  mount-dropbox
  ^python3 -c '
import os
import subprocess
import gi

gi.require_version("Gtk", "3.0")
gi.require_version("AyatanaAppIndicator3", "0.1")
from gi.repository import AyatanaAppIndicator3, GLib, Gtk

mount = os.path.join(os.environ["HOME"], "Dropbox")
indicator = AyatanaAppIndicator3.Indicator.new(
    "dropbox-sync",
    "network-server",
    AyatanaAppIndicator3.IndicatorCategory.APPLICATION_STATUS,
)
indicator.set_status(AyatanaAppIndicator3.IndicatorStatus.ACTIVE)

menu = Gtk.Menu()
status = Gtk.MenuItem.new_with_label("Dropbox: checking...")
status.set_sensitive(False)
menu.append(status)
quit_item = Gtk.MenuItem.new_with_label("Quit")
quit_item.connect("activate", lambda *_: Gtk.main_quit())
menu.append(quit_item)
menu.show_all()
indicator.set_menu(menu)

def update():
    mounted = subprocess.run(["mountpoint", "-q", mount]).returncode == 0
    label = "Dropbox mounted" if mounted else "Dropbox not mounted"
    indicator.set_icon_full("folder-remote" if mounted else "network-offline", label)
    status.set_label(label)
    return True

update()
GLib.timeout_add_seconds(5, update)
Gtk.main()
  '
}

def check-sync [] {
  let p = (require-mount)
  let remote = (dropbox-remote)
  let vfs = (rc $p.socket vfs/stats)
  let stats = (rc $p.socket core/stats short=true)
  let queued = ($vfs | get -o diskCache.uploadsQueued | default 0)
  let uploading = ($vfs | get -o diskCache.uploadsInProgress | default 0)
  let errors = (($vfs | get -o diskCache.erroredFiles | default 0) + ($stats | get -o errors | default 0))
  let out_of_space = ($vfs | get -o diskCache.outOfSpace | default false)

  print $"Mount:   OK \(($p.dir)\)"
  let remote_check = (^rclone lsf $remote --max-depth 1 | complete)
  if $remote_check.exit_code != 0 {
    print "Remote:  ERROR"
    print --stderr ($remote_check.stderr | str trim)
    exit 1
  }
  print "Remote:  OK"
  print $"Uploads: ($queued) queued, ($uploading) active"
  print $"Errors:  ($errors)"

  if $errors != 0 or $out_of_space {
    if $out_of_space { print "Cache:   OUT OF SPACE" }
    let last_error = ($stats | get -o lastError | default "")
    if not ($last_error | is-empty) { print $"Last:    ($last_error)" }
    exit 1
  }
  print "Sync:    OK"
}

def force-sync [] {
  let p = (require-mount)
  let items = (rc $p.socket vfs/queue | get -o queue | default [])
  for item in $items {
    rc $p.socket vfs/queue-set-expiry $"id=($item.id)" expiry=-1000000000 | ignore
  }
  rc $p.socket vfs/refresh recursive=true | ignore
  print $"Prioritized ($items | length) queued upload\(s\) and refreshed Dropbox."
}

# One lock per local folder; transfers are serialized, not concurrent.
def transfer [mode: string, dry_run: bool, initialize: bool] {
  let p = (paths)
  if (is-mounted $p.dir) {
    error make {msg: "Close applications using Dropbox, then run: dropbox-sync --unmount"}
  }
  let remote = (dropbox-remote)
  let state = ($p.log | path dirname | path join bisync)
  let ready = ($state | path join initialized)
  if $mode == "sync" and not $initialize and not ($ready | path exists) {
    error make {msg: "Initialize first: --sync --init --dry-run, then --sync --init. Initialization prefers Dropbox for matching paths; back up both sides first."}
  }
  if $mode != "sync" and ($ready | path exists) {
    error make {msg: "Bisync is initialized; use --sync instead. One-way copies would invalidate its change tracking."}
  }
  if $mode == "push" and not ($p.dir | path exists) {
    error make {msg: "Local Dropbox folder does not exist; nothing to upload."}
  }
  mkdir $p.dir $state
  mut args = if $mode == "pull" {
    [copy $remote $p.dir --update]
  } else if $mode == "push" {
    [copy $p.dir $remote --update]
  } else {
    [bisync $p.dir $remote --workdir $state --resilient --recover --conflict-resolve none --conflict-loser num]
  }
  if $initialize { $args = ($args | append [--resync --resync-mode path2]) }
  if $dry_run { $args = ($args | append '--dry-run') }
  # Leftovers from the Dropbox desktop client are local-only (and .dropbox is
  # rejected by the API). Apply the same filters to every transfer, including
  # bisync resync, so these files never enter its change tracking.
  $args = ($args | append [--exclude /.dropbox --exclude /.dropbox.attr --exclude /.dropbox.cache/** --exclude /.Trash-*/**])
  # Keep replaced copy destinations outside the synced tree, on the same backend.
  if $mode != "sync" {
    let stamp = (date now | format date "%Y%m%dT%H%M%S%f")
    let backup = if $mode == "pull" {
      $p.log | path dirname | path join backups $stamp
    } else {
      $"($remote).dropbox-sync-backups/($stamp)"
    }
    $args = ($args | append [--backup-dir $backup --exclude /.dropbox-sync-backups/**])
  } else {
    $args = ($args | append [--exclude /.dropbox-sync-backups/**])
  }
  ^flock --nonblock ($state | path join transfer.lock) rclone ...$args --verbose --contimeout 15s --timeout 1m
  if $env.LAST_EXIT_CODE != 0 {
    error make {msg: "Transfer failed or another transfer is running. Inspect rclone's output. If bisync aborted, back up both sides and review --sync --init --dry-run before retrying --sync --init; do not automatically reinitialize."}
  }
  if $initialize and not $dry_run { "" | save --force $ready }
}

def schedule [interval: string] {
  let p = (paths)
  let ready = ($p.log | path dirname | path join bisync initialized)
  if not ($ready | path exists) or (is-mounted $p.dir) {
    error make {msg: "Unmount Dropbox and complete --sync --init before enabling the schedule."}
  }
  if $interval !~ '^[1-9][0-9]*(s|min|h)$' {
    error make {msg: "Interval must be a positive integer followed by s, min, or h (for example 30s or 5min)."}
  }
  let units = (($env.XDG_CONFIG_HOME? | default ($env.HOME | path join .config)) | path join systemd user)
  mkdir $units
  let script = ($env.CURRENT_FILE | path expand)
  let nu_bin = (which nu | first | get path)
  # systemd treats percent signs as specifiers, even inside quotes.
  let command = ([$nu_bin $script] | each {|s| '"' + ($s | str replace --all '\' '\\' | str replace --all '"' '\"' | str replace --all '%' '%%' | str replace --all '$' '$$') + '"' } | str join ' ')
  $"[Unit]\nDescription=Two-way Dropbox sync\n\n[Service]\nType=oneshot\nExecStart=($command) --sync\n" | save --force ($units | path join dropbox-sync.service)
  $"[Unit]\nDescription=Periodically sync Dropbox\n\n[Timer]\nOnStartupSec=30s\nOnUnitInactiveSec=($interval)\nAccuracySec=1s\n\n[Install]\nWantedBy=timers.target\n" | save --force ($units | path join dropbox-sync.timer)
  ^systemctl --user daemon-reload
  if $env.LAST_EXIT_CODE != 0 { error make {msg: "systemd user daemon-reload failed"} }
  ^systemctl --user enable --now dropbox-sync.timer
  if $env.LAST_EXIT_CODE != 0 { error make {msg: "Could not enable timer"} }
  ^systemctl --user restart dropbox-sync.timer
  if $env.LAST_EXIT_CODE != 0 { error make {msg: "Could not restart timer"} }
  print $"Sync scheduled every ($interval) after completion while your user manager runs. Logs: journalctl --user -u dropbox-sync.service"
}

def main [
  --pull        # Download without deleting; skip newer local files, back up replacements
  --push        # Upload without deleting; skip newer remote files, back up replacements
  --sync        # Run two-way sync (including deletions); preserve conflicting versions
  --init        # Initialize/rebuild bisync tracking; Dropbox wins matching paths
  --dry-run     # Preview a transfer without changing files
  --schedule: string # Enable two-way sync timer, e.g. --schedule 30s
  --unschedule  # Disable timer and stop its running transfer
  --unmount (-u) # Unmount Dropbox; refuse pending uploads or cache errors
  --setup (-s)  # Open rclone's interactive configuration
  --force (-f)  # Upload queued local changes now and refresh the mount
  --check (-c)  # Show mount, connection, upload, and error status
  --tray (-t)   # Mount Dropbox and show its status in the system tray
] {
  if (which rclone | is-empty) {
    error make {msg: "rclone is not installed"}
  }
  if $tray and (which python3 | is-empty) {
    error make {msg: "python3 is required for --tray"}
  }
  if ([$setup $force $check $tray $pull $push $sync ($schedule != null) $unschedule $unmount] | where {$in} | length) > 1 {
    error make {msg: "Choose only one option"}
  }

  if $init and not $sync { error make {msg: "--init requires --sync"} }
  if $dry_run and not ($pull or $push or $sync) { error make {msg: "--dry-run requires --pull, --push, or --sync"} }
  if $pull or $push or $sync {
    if (which flock | is-empty) { error make {msg: "flock is required for local transfers"} }
    transfer (if $pull { "pull" } else if $push { "push" } else { "sync" }) $dry_run $init
  } else if $schedule != null {
    schedule $schedule
  } else if $unschedule {
    ^systemctl --user disable --now dropbox-sync.timer
    if $env.LAST_EXIT_CODE != 0 { error make {msg: "Could not disable timer"} }
    ^systemctl --user stop dropbox-sync.service
    if $env.LAST_EXIT_CODE != 0 { error make {msg: "Could not stop transfer"} }
  } else if $unmount {
    unmount-dropbox
  } else if $setup { setup } else if $force { force-sync } else if $check { check-sync } else if $tray { tray } else { mount-dropbox }
}
