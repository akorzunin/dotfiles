#!/usr/bin/env nu

def --wrapped main [
    --default
    --edit
    --explore
    --subagent
    ...args: string
] {
    let agent_dir = ($env.PI_CODING_AGENT_DIR? | default ($nu.home-dir | path join ".pi/agent") | path expand)
    let manifest = (open ($agent_dir | path join extensions.json))
    let always_extensions = ($manifest.always | each {|source|
        if ($source | str starts-with "npm:") { $source } else { $agent_dir | path join $source }
    })
    let subagent_extensions = $manifest.subagent
    # Pin known opt-in sources too, but leave arbitrary user extensions untouched.
    let args = ($args | enumerate | each {|item|
        if $item.index > 0 and (($args | get ($item.index - 1)) in [-e --extension]) {
            $manifest.optional | where {|source| ($source | str replace -r '@[0-9]+\.[0-9]+\.[0-9]+$' '') == $item.item } | get -o 0 | default $item.item
        } else {
            $item.item
        }
    })
    let is_child = (($env.PI_SUBAGENT_CHILD? | default "") != "")
    let mode = if $is_child {
        "edit"
    } else if $subagent {
        "subagent"
    } else if $explore {
        "explore"
    } else if $edit {
        "edit"
    } else {
        "default"
    }

    let no_extensions = ($args | any {|arg| $arg == "--no-extensions" or $arg == "-ne" })
    let extensions = if $no_extensions {
        []
    } else if $mode == "explore" {
        $always_extensions ++ [($nu.home-dir | path join ".pi/agent/extensions/explore/prompt.ts")]
    } else if $mode == "subagent" {
        $always_extensions ++ $subagent_extensions
    } else {
        $always_extensions
    }
    let extension_args = ($extensions | each {|extension| [-e $extension] } | flatten)
    let extension_discovery_args = if $no_extensions { [] } else { [--no-extensions] }
    let skill_discovery_args = if $no_extensions { [] } else { [--no-skills] }
    let mode_args = if $mode == "default" {
        []
    } else if $mode == "explore" {
        [--system-prompt "" --no-session --no-builtin-tools --no-context-files --no-skills --no-prompt-templates --no-mcp]
    } else {
        [--system-prompt ""]
    }

    if $mode == "subagent" {
        $env.PI_SUBAGENT_PI_BINARY = (
            $env.PI_SUBAGENT_PI_BINARY?
            | default ($env.CURRENT_FILE | path expand)
        )
    }

    let configured_agent_dir = ($env.PI_CODING_AGENT_DIR? | default "")
    if $configured_agent_dir == "" {
        $env.PI_CODING_AGENT_DIR = (
            ^realpath ($nu.home-dir | path join ".pi/agent")
            | str trim
        )
    }

    ^pi ...$extension_discovery_args ...$skill_discovery_args ...$extension_args ...$mode_args ...$args
}
